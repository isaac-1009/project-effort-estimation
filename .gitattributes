# Normalize text files to LF in the repo regardless of OS checkout.
# Git will check out as CRLF on Windows via core.autocrlf, but commits stay LF.
* text=auto eol=lf

# Binary files — never normalize
*.xlsx binary
*.xls binary
*.pptx binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.drawio binary
